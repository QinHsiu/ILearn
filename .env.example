# OpenAI-compatible LLM (optional for offline CLI demo with --auto-answer)
ILEARN_LLM_BASE_URL=
ILEARN_LLM_API_KEY=
ILEARN_LLM_MODEL=

# Vision model for handwriting / image step grading (optional; falls back to ILEARN_LLM_MODEL)
ILEARN_VISION_MODEL=

# Streamlit -> FastAPI base URL (API listens on :8000 by default)
ILEARN_API_BASE=http://127.0.0.1:8000

# Curriculum retriever backend: keyword (default) | hash_vector | qdrant (stub)
ILEARN_RETRIEVER_BACKEND=keyword

# Diagnosis / platform (Edition 0830_2)
ILEARN_MASTERY_THRESHOLD=0.7
ILEARN_MAX_HINT_PER_QUESTION=3
ILEARN_RATE_LIMIT_ENABLED=1
ILEARN_RATE_LIMIT_MAX_REQUESTS=100
ILEARN_RATE_LIMIT_WINDOW_SECONDS=60

# Demo web login credentials (change these outside local development)
ILEARN_PARENT_USERNAME=parent-demo
ILEARN_PARENT_PASSWORD=parent-demo-password
ILEARN_PARENT_USER_ID=parent-demo
ILEARN_TEACHER_USERNAME=teacher-demo
ILEARN_TEACHER_PASSWORD=teacher-demo-password
ILEARN_TEACHER_USER_ID=teacher-demo
