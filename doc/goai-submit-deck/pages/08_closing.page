pageType: content
background:
  type: solid
  color: "$soft"
elements:
  - elementId: accent-bar
    elementType: shape
    bounds: [48, 32, 56, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: page-title
    elementType: text
    bounds: [48, 48, 860, 36]
    content:
      style: "$title"
      wrap: false
      text: 技术实现 · 合规 · 开源
  - elementId: left
    elementType: shape
    bounds: [48, 100, 430, 220]
    shapeName: roundRect
    fill:
      type: solid
      color: "$white"
    border:
      style: solid
      width: 1
      color: "$line"
  - elementId: left-t
    elementType: text
    bounds: [68, 118, 390, 185]
    content:
      fontSize: 16
      color: "$text"
      lineHeight: 1.45
      fontFamily: {latin: MiSans, ea: MiSans}
      text: |
        <p><strong style="color:#002FA7;">技术栈与质量</strong></p>
        <p style="margin-top:10px">FastAPI + React · Pydantic + Vite</p>
        <p>Qdrant + WeasyPrint / fpdf2</p>
        <p style="margin-top:12px">554+ 后端测试 · 73+ 前端测试</p>
        <p>零 LLM 可离线运行</p>
  - elementId: right
    elementType: shape
    bounds: [500, 100, 412, 220]
    shapeName: roundRect
    fill:
      type: solid
      color: "$white"
    border:
      style: solid
      width: 1
      color: "$line"
  - elementId: right-t
    elementType: text
    bounds: [520, 118, 372, 185]
    content:
      fontSize: 15
      color: "$text"
      lineHeight: 1.4
      fontFamily: {latin: MiSans, ea: MiSans}
      text: |
        <p><strong style="color:#002FA7;">数据与合规</strong></p>
        <p style="margin-top:8px">小学数学 4–6 年级 · 人教课标</p>
        <p>公开题库 + 模拟画像（化名）</p>
        <p>无真实个人信息持久化</p>
        <p>AI 诊断仅供参考，需教师确认</p>
        <p style="margin-top:6px; color:#5F6B7A;">符合数据安全法 / 个保法要求</p>
  - elementId: cta-bg
    elementType: shape
    bounds: [48, 350, 864, 140]
    shapeName: roundRect
    fill:
      type: solid
      color: "$primary"
  - elementId: cta
    elementType: text
    bounds: [68, 368, 824, 110]
    content:
      fontSize: 17
      color: "$white"
      lineHeight: 1.45
      fontFamily: {latin: MiSans, ea: MiSans}
      text: |
        <p><strong>ILearn —— 让每个孩子拥有课标对齐、数据驱动、持续进化的 AI 学习伙伴</strong></p>
        <p style="margin-top:10px">开源地址：https://github.com/QinHsiu/ILearn　·　60 秒上手</p>
        <p style="margin-top:8px">感谢评委，欢迎提问！</p>
