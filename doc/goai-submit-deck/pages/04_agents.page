pageType: content
background:
  type: solid
  color: "$soft"
elements:
  - elementId: accent-bar
    elementType: shape
    bounds: [48, 32, 56, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: page-title
    elementType: text
    bounds: [48, 48, 860, 36]
    content:
      style: "$title"
      wrap: false
      text: 多 Agent 协同架构
  - elementId: page-sub
    elementType: text
    bounds: [48, 90, 860, 24]
    content:
      style: "$caption"
      wrap: false
      text: 五 Agent 流水线协同 · 全流程可观测、可追溯
  - elementId: agents
    elementType: table
    bounds: [48, 128, 864, 250]
    columnWidths: [0.28, 0.22, 0.5]
    rowHeights: [0.166, 0.166, 0.166, 0.166, 0.166, 0.17]
    style: "$default"
    rows:
      - - text: Agent
        - text: 职责
        - text: 关键能力
      - - text: Curriculum
        - text: 课标检索
        - text: keyword / hash_vector / Qdrant 对齐
      - - text: Assessment
        - text: 自适应组卷
        - text: 诊断卷 · 巩固卷 · 能力分层
      - - text: Practice / Tutor
        - text: 批改与辅导
        - text: 即时反馈 · 苏格拉底三级提示
      - - text: Diagnosis
        - text: 证据诊断
        - text: Evidence Log · diagnosis_confidence
      - - text: Planning
        - text: 计划生成
        - text: 科学学习方法 · 间隔复习 · 可重规划
  - elementId: footer
    elementType: text
    bounds: [48, 400, 864, 100]
    content:
      fontSize: 16
      color: "$text"
      lineHeight: 1.45
      fontFamily: {latin: MiSans, ea: MiSans}
      text: |
        <p><strong style="color:#002FA7;">关键能力</strong></p>
        <p style="margin-top:8px">课标对齐 · 证据驱动 · 编排可观测（decision_log + 上下文预算）</p>
        <p style="margin-top:6px; color:#5F6B7A;">零 LLM 可离线降级运行，规则引擎保障演示与试点稳定性</p>
