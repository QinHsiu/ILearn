pageType: content
background:
  type: solid
  color: "$soft"
elements:
  - elementId: accent-bar
    elementType: shape
    bounds: [48, 32, 56, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: page-title
    elementType: text
    bounds: [48, 48, 860, 36]
    content:
      style: "$title"
      wrap: false
      text: ILearn 解决方案
  - elementId: page-sub
    elementType: text
    bounds: [48, 90, 860, 28]
    content:
      style: "$caption"
      wrap: false
      text: 课标在环 · 多 Agent 协同 · 自适应个性化学习
  - elementId: pipeline-bg
    elementType: shape
    bounds: [48, 130, 864, 170]
    shapeName: roundRect
    fill:
      type: solid
      color: "$white"
    border:
      style: solid
      width: 1
      color: "$line"
  - elementId: pipeline
    elementType: text
    bounds: [64, 150, 832, 130]
    content:
      fontSize: 17
      color: "$text"
      align: center
      lineHeight: 1.55
      fontFamily: {latin: MiSans, ea: MiSans}
      text: |
        <p><strong>测评 → 批改 → 诊断 → 规划 → 巩固</strong></p>
        <p style="margin-top:14px">找缺口　　即时反馈　　定位根因　　生成方案　　闭环验证</p>
        <p style="margin-top:18px; color:#5F6B7A; font-size:15px;">五个环节环环相扣，形成可验证的完整学习闭环</p>
  - elementId: role1
    elementType: shape
    bounds: [48, 330, 270, 150]
    shapeName: roundRect
    fill:
      type: solid
      color: "$white"
    border:
      style: solid
      width: 1
      color: "$line"
  - elementId: role1-t
    elementType: text
    bounds: [64, 350, 238, 110]
    content:
      fontSize: 16
      color: "$text"
      lineHeight: 1.4
      fontFamily: {latin: MiSans, ea: MiSans}
      text: |
        <p><strong style="color:#002FA7;">教师端</strong></p>
        <p style="margin-top:10px">班级扫描与干预</p>
        <p>薄弱点排行 · 优先名单</p>
  - elementId: role2
    elementType: shape
    bounds: [345, 330, 270, 150]
    shapeName: roundRect
    fill:
      type: solid
      color: "$white"
    border:
      style: solid
      width: 1
      color: "$line"
  - elementId: role2-t
    elementType: text
    bounds: [361, 350, 238, 110]
    content:
      fontSize: 16
      color: "$text"
      lineHeight: 1.4
      fontFamily: {latin: MiSans, ea: MiSans}
      text: |
        <p><strong style="color:#002FA7;">家长端</strong></p>
        <p style="margin-top:10px">纯净报告与建议</p>
        <p>日常用语 · 可操作</p>
  - elementId: role3
    elementType: shape
    bounds: [642, 330, 270, 150]
    shapeName: roundRect
    fill:
      type: solid
      color: "$white"
    border:
      style: solid
      width: 1
      color: "$line"
  - elementId: role3-t
    elementType: text
    bounds: [658, 350, 238, 110]
    content:
      fontSize: 16
      color: "$text"
      lineHeight: 1.4
      fontFamily: {latin: MiSans, ea: MiSans}
      text: |
        <p><strong style="color:#002FA7;">学生端</strong></p>
        <p style="margin-top:10px">自适应测评与激励</p>
        <p>苏格拉底引导 · 星星</p>
